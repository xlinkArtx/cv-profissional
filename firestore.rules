rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function protegidos() {
      return ['paid', 'payment', 'paymentStatus', 'downloadAllowed', 'orderId'];
    }

    match /users/{userId} {
      allow read: if dono(userId);
      allow create: if dono(userId)
        && !request.resource.data.keys().hasAny(protegidos());
      allow update: if dono(userId)
        && !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(protegidos());
      allow delete: if false;

      match /cvs/{cvId} {
        allow read, delete: if dono(userId);
        allow create: if dono(userId)
          && !request.resource.data.keys().hasAny(protegidos());
        allow update: if dono(userId)
          && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(protegidos());
      }
    }
  }
}